{
  "name": "template-core",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.0.0",
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json && pnpm --filter @erp/web typecheck && pnpm --filter @erp/mobile typecheck",
    "test": "vitest run",
    "test:e2e": "vitest run tests/e2e",
    "check": "pnpm typecheck && pnpm test && node --import tsx tools/erp/src/cli.ts verify",
    "erp": "node --import tsx tools/erp/src/cli.ts",
    "db:dev": "bash scripts/dev-db.sh",
    "test:ui": "pnpm --filter @erp/web build && vitest run --config vitest.ui.config.ts",
    "uat": "pnpm --filter @erp/web build && vitest run --config vitest.uat.config.ts --reporter=default --reporter=json --outputFile.json=docs/uat/run.json",
    "test:report": "vitest run --reporter=default --reporter=json --outputFile.json=docs/uat/system.json && vitest run --config vitest.ui.config.ts --reporter=default --reporter=json --outputFile.json=docs/uat/browser.json",
    "uat:pack": "pnpm test:report && pnpm uat && pnpm erp uat-report",
    "demo": "node --import tsx tools/erp/src/demo-cli.ts",
    "site": "node --import tsx site/build.ts"
  },
  "devDependencies": {
    "@erp/contracts": "workspace:*",
    "@erp/gateway": "workspace:*",
    "@erp/kernel": "workspace:*",
    "@erp/svc-accounting": "workspace:*",
    "@erp/svc-approvals": "workspace:*",
    "@erp/svc-assets": "workspace:*",
    "@erp/svc-automation": "workspace:*",
    "@erp/svc-booking": "workspace:*",
    "@erp/svc-contracts": "workspace:*",
    "@erp/svc-costing": "workspace:*",
    "@erp/svc-crm": "workspace:*",
    "@erp/svc-etax": "workspace:*",
    "@erp/svc-expense": "workspace:*",
    "@erp/svc-helpdesk": "workspace:*",
    "@erp/svc-hr": "workspace:*",
    "@erp/svc-identity": "workspace:*",
    "@erp/svc-inventory": "workspace:*",
    "@erp/svc-maintenance": "workspace:*",
    "@erp/svc-master-data": "workspace:*",
    "@erp/svc-payroll": "workspace:*",
    "@erp/svc-production": "workspace:*",
    "@erp/svc-projects": "workspace:*",
    "@erp/svc-purchasing": "workspace:*",
    "@erp/svc-quality": "workspace:*",
    "@erp/svc-sales": "workspace:*",
    "@erp/thai": "workspace:*",
    "@erp/ui-schema": "workspace:*",
    "@types/node": "^22.10.0",
    "@types/pg": "^8.11.10",
    "playwright-core": "1.56.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
