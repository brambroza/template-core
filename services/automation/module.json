{
  "id": "automation",
  "name": "Automation & Alerts",
  "nameTh": "ระบบอัตโนมัติ",
  "version": "0.2.0",
  "tier": "feature",
  "description": "No-code rules: when something happens in any installed module (stock low, machine down, big PO, invoice issued…), check conditions and notify in the app, on LINE or by webhook. Ships with ready-made rule templates.",
  "requires": ["identity"],
  "enhancedBy": ["inventory", "purchasing", "sales", "production", "maintenance", "approvals", "expense", "hr", "helpdesk", "crm", "quality", "booking", "assets"],
  "publishes": [],
  "subscribes": [
    "inventory.low_stock",
    "purchasing.po_created",
    "purchasing.po_approved",
    "purchasing.goods_received",
    "sales.order_confirmed",
    "sales.delivered",
    "sales.invoiced",
    "production.completed",
    "maintenance.breakdown_reported",
    "maintenance.work_completed",
    "approvals.request_submitted",
    "approvals.request_decided",
    "expense.claim_submitted",
    "expense.claim_paid",
    "hr.leave_requested",
    "hr.leave_decided",
    "helpdesk.ticket_created",
    "helpdesk.ticket_resolved",
    "crm.lead_created",
    "crm.quotation_accepted",
    "quality.inspection_completed",
    "quality.ncr_raised",
    "booking.requested",
    "assets.repair_reported"
  ],
  "permissions": [
    { "key": "automation.rule.read", "label": "ดูกฎอัตโนมัติ" },
    { "key": "automation.rule.write", "label": "สร้าง/แก้ไขกฎอัตโนมัติ" },
    { "key": "automation.notify.read", "label": "รับการแจ้งเตือน" }
  ]
}
