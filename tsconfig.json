{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noUncheckedIndexedAccess": false,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "types": ["node"]
  },
  "include": ["apps/gateway/src", "apps/gateway/test", "packages/*/src", "packages/*/test", "services/*/src", "services/*/test", "services/*/ext", "docs/examples", "tools/*/src", "tests"]
}
